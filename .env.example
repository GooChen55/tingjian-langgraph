# Optional fallback configuration. Prefer encrypted model settings in the admin UI.
# Copy to .env only when needed; never commit .env with real secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# MySQL host port; keep this consistent for startup and verification commands.
LISTENING_DB_PORT=24316

# Personal knowledge ports. Only these adapters are implemented today.
# Unknown cloud adapters fail explicitly; replacing a name does not install one.
LISTENING_PERSONAL_OBJECT_BACKEND=minio
LISTENING_PERSONAL_VECTOR_BACKEND=milvus
LISTENING_PERSONAL_PARSER_BACKEND=pypdf
